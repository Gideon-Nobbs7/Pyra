# Pyra example environment. Copy to .env and set real values.
# Never commit .env (root .gitignore covers it). No secrets in this file.
# NOTE: POSTGRES_* bake in on first volume init; changing them later
# requires: docker compose down -v db && docker compose up -d db
# DATABASE_URL must use the same user, password, and db as above.
POSTGRES_USER=pyra
POSTGRES_PASSWORD=changeme
POSTGRES_DB=pyra
DATABASE_URL=postgresql://USER:PASSWORD@CLOUD-SQL-HOST:5432/pyra
# Tier 2 fallback: Supabase pooler. Served only if the primary is unreachable;
# freshness.store names whichever store answered.
DATABASE_URL_FALLBACK=postgresql://postgres.blcwrgryptopcmzwkjrc:changeme@aws-0-eu-north-1.pooler.supabase.com:6543/postgres
# Tier 3 fallback: local Compose PostGIS (offline use).
DATABASE_URL_LOCAL=postgresql://pyra:changeme@localhost:5433/pyra
LOG_LEVEL=INFO
# FIRMS NRT API key (server-side only, never in frontend). Request at the
# FIRMS web-services page; emailed to your Earthdata address.
FIRMS_MAP_KEY=
# Optional JSON override when FIRMS renames a product (no code change needed).
# Keys must be a subset of: modis, viirs_n20, viirs_n21.
# FIRMS_API_PRODUCTS={"modis": "MODIS_NRT"}

EE_PROJECT=
EE_CREDENTIALS_PATH=~/.secrets/pyra-ee-key.json
