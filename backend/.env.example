# Backend keys live in the REPO-ROOT .env (auto-loaded by app/settings.py).
# This file documents the names only. Copy values into <repo>/.env.
# Never commit real secrets. Provider keys stay server-side.
DATABASE_URL=
DATABASE_URL_FALLBACK=
DATABASE_URL_LOCAL=
FIRMS_MAP_KEY=
# FIRMS_API_PRODUCTS={"modis": "MODIS_NRT"}
EE_PROJECT=
EE_CREDENTIALS_PATH=
CACHE_BACKEND=lru
# Rolling ingest worker (scripts/ingest_worker.py). Labels allow spaces; one
# entry per area, separated by semicolons. Also honors exported shell vars.
WATCH_BBOXES=Tamale:-2.2,8.05,0.52,10.75;Ghana:-3.3,4.5,1.2,11.2
WORKER_INTERVAL_S=10
WORKER_RECENT_DAYS=7
WORKER_MAX_JOBS=3
# 1 to run the ingest worker inside the API process (one uvicorn owns both).
WORKER_ENABLED=1
