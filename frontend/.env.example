# Pyra frontend environment. Copy to .env and adjust locally. Never commit .env.
# Leave VITE_API_BASE_URL unset for the default wiring:
#   - `npm run dev`  -> same-origin /api, proxied to http://localhost:8000 (see vite.config.ts)
#   - production     -> same-origin /api served by the FastAPI app (one origin, no CORS)
# Set it only for a split-origin deployment (requires backend CORS, not enabled by default).
# VITE_API_BASE_URL=http://localhost:8000/api/v1
# VITE_DEMO_MODE=false forces real API results and errors. When true (or unset in
# dev), unreachable API calls silently fall back to synthetic fixtures.
VITE_DEMO_MODE=false
